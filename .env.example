# Supabase — the site works without these (falls back to bundled seed data),
# but set them to enable live events, news and the contact form.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for canonical URLs, sitemap and OG tags.
# Defaults to https://crescent-global-calender.vercel.app when unset.
# Override for local dev (http://localhost:3000) or preview deployments.
NEXT_PUBLIC_SITE_URL=

# Show the "Continue with Google" button on the Crescent Connect auth pages.
#
# Defaults to false. Leave it false until the Google provider is actually
# enabled in Supabase (Authentication -> Providers -> Google, with
# https://<your-domain>/connect/callback as an authorised redirect).
#
# While the provider is disabled, every click on that button returns
# "Unsupported provider: provider is not enabled" — which is exactly why the
# flag exists. Set to the literal string "true" to turn it on, then redeploy:
# NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
